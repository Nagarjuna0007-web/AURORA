# Copy to .env and edit. Never commit .env.
APP_NAME=AURORA
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=False
MODEL_NAME=llama3
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
CONTEXT_WINDOW=10
# Embeddings for RAG: "ollama" (default, run: ollama pull nomic-embed-text) or "huggingface" (needs requirements-hf.txt)
EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text
